+/**
+ * Parameterized F1-04 live runner for authenticated F1-02 ledger + F1-03 browser adapters.
+ * Requires explicit humanLiveSendAuthorized === true AND all three liveProofs.
+ * Note: runFirstMessageAttempt() remains permanently inert while FIRST_MESSAGE_LIVE_SEND_ENABLED is false.
+ */
+export async function executeFirstMessageWithAdapters(
+  ledger: FirstMessageLedgerPort,
+  browser: FirstMessageBrowserPort,
+  options: ExecuteFirstMessageOptions,
+): Promise<LiveFirstMessageResult> {
+  const phases: ProtocolPhase[] = [];
+  const makeOutcome = (
+    status: LiveFirstMessageResult["status"],
+    code: string,
+    submitInvocations = 0,
+    conversationId: string | null = null,
+    authority: LiveFirstMessageResult["authority"] = "NONE",
+    externalIoPerformed = false,
+  ): LiveFirstMessageResult => ({
+    status,
+    code,
+    authority,
+    externalIoPerformed,
+    submitInvocations,
+    phases,
+    conversationId,
+  });
+
+  if (
+    options?.humanLiveSendAuthorized !== true ||
+    options.liveProofs?.githubCasOwnerCertified !== true ||
+    options.liveProofs?.nativePairingOwnerCertified !== true ||
+    options.liveProofs?.realBrowserOwnerAccepted !== true
+  ) {
+    return makeOutcome("BLOCKED", "LIVE_SEND_DISABLED", 0, null, "NONE", false);
+  }
+
+  const nowFn = options.nowIso ?? (() => new Date().toISOString());
+  let claimConsumed = false;
+  let reconciliationCommitted = false;
+
+  try {
+    phases.push("OBSERVE_INITIAL");
+    const t0 = nowFn();
+    const initialObservation = await browser.observe(t0);
+    const initialSnapshot = await ledger.loadSnapshot("PREPARE", initialObservation, t0);
+    phases.push("VALIDATE_FRESH_LANDING");
+    const freshResult = evaluateFreshChatLanding(initialSnapshot.freshAttempt);
+    if (freshResult.decision !== "CANDIDATE_ONLY" || freshResult.code !== "FRESH_CHAT_LANDING_CANDIDATE") {
+      return makeOutcome("BLOCKED", freshResult.code, 0, null, "AUTHENTICATED_ADAPTER", true);
+    }
+    const prepare = evaluateBootstrapFence(initialSnapshot.bootstrap);
+    if (prepare.decision !== "CANDIDATE_ONLY" || prepare.code !== "PREPARE_CANDIDATE") {
+      return makeOutcome("BLOCKED", prepare.code, 0, null, "AUTHENTICATED_ADAPTER", true);
+    }
+    phases.push("PREPARE_CANDIDATE");
+    const prompt = buildApprovedBootstrapPrompt(initialSnapshot.bootstrap.request);
+    if (!prompt) {
+      return makeOutcome("BLOCKED", "PREPARE_BLOCKED", 0, null, "AUTHENTICATED_ADAPTER", true);
+    }
+
+    const req = initialSnapshot.bootstrap.request;
+    const fenceNow = nowFn();
+    const fence: DurablePreSendFence = options.makeFence
+      ? options.makeFence(req, fenceNow)
+      : {
+          durable: true,
+          fenceId: `fence-${req.attemptId}`,
+          commitSha: req.headSha,
+          attemptId: req.attemptId,
+          workerId: req.workerId,
+          headSha: req.headSha,
+          targetId: req.targetId,
+          profileId: req.profileId,
+          targetTabId: req.targetTabId,
+          executionId: req.executionId,
+          generation: 1,
+          committedAt: fenceNow,
+        };
+
+    phases.push("COMMIT_FENCE");
+    const fenceWrite = await ledger.commitPreSendFence(fence);
+    if (fenceWrite.status !== "COMMITTED" || !fenceWrite.commitSha) {
+      return makeOutcome("BLOCKED", "FENCE_COMMIT_FAILED", 0, null, "AUTHENTICATED_ADAPTER", true);
+    }
+    phases.push("READ_BACK_FENCE");
+    const fenceReadOk = await ledger.readBackPreSendFence(fenceWrite.commitSha);
+    if (!fenceReadOk) {
+      return makeOutcome("BLOCKED", "FENCE_READBACK_BLOCKED", 0, null, "AUTHENTICATED_ADAPTER", true);
+    }
+
+    const t1 = nowFn();
+    const fenceObservation = await browser.observe(t1);
+    const fenceSnapshot = await ledger.loadSnapshot("VERIFY_FENCE_COMMIT", fenceObservation, t1);
