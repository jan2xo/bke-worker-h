+      await ledger.markDeliveryUncertain();
+      phases.push("QUARANTINE_UNCERTAIN_DELIVERY");
+      return makeOutcome("BLOCKED", "DELIVERY_UNCERTAIN", browser.submissionCount, null, "AUTHENTICATED_ADAPTER", true);
+    }
+
+    phases.push("OBSERVE_POST_SEND");
+    const t3 = nowFn();
+    const postSendObservation = await browser.observe(t3);
+    const confirmationSnapshot = await ledger.loadSnapshot("CONFIRM_NEW_CONVERSATION", postSendObservation, t3);
