+  assert.equal(result.simulatedSubmitInvocations, 0);
+  assert.equal(result.phases.includes("COMMIT_SEND_CLAIM"), false);
+  assert.equal(result.phases.includes("SIMULATED_SINGLE_SUBMIT"), false);
