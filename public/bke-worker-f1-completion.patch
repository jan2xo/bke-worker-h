+      return makeOutcome("BLOCKED", "DELIVERY_UNCERTAIN", 0, null, "AUTHENTICATED_ADAPTER", true);
+    }
+    claimConsumed = true;
+
+    phases.push("READ_BACK_SEND_CLAIM");
+    const claimReadOk = await ledger.readBackFirstSendClaim(claimWrite.commitSha);
+    if (!claimReadOk) {
+      await ledger.markDeliveryUncertain();
+      phases.push("QUARANTINE_UNCERTAIN_DELIVERY");
+      return makeOutcome("BLOCKED", "SEND_CLAIM_READBACK_BLOCKED", 0, null, "AUTHENTICATED_ADAPTER", true);
+    }
