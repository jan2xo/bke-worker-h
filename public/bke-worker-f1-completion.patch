+    phases.push("REOBSERVE_AFTER_CLAIM");
+    const t2 = nowFn();
+    const afterClaimObservation = await browser.observe(t2);
+    const submissionSnapshot = await ledger.loadSnapshot("AUTHORIZE_FIRST_SUBMISSION", afterClaimObservation, t2);
+    phases.push("AUTHORIZE_FIRST_SUBMISSION");
