@@ -0,0 +1,475 @@
+/**
+ * F1-03 persistent authenticated Chrome Native Host <-> Controller Bridge.
+ *
+ * Authenticates the extension via P-256 HELLO -> CHALLENGE -> PROOF, emits
+ * SESSION_ESTABLISHED, and then serves a serial single-flight controller command
+ * loop with replay protection, TTL enforcement, and fail-closed quarantine on
+ * mid-dispatch disconnect or protocol violation.
+ */
+import { createPublicKey, randomBytes, verify, createHash } from "node:crypto";
+import { createServer } from "node:net";
+import { lstat, mkdir, rm } from "node:fs/promises";
+import { dirname } from "node:path";
+import { encodeFrame, MAX_FRAME_BYTES, nativeFrameReader } from "./framing.mjs";
+import { nativeProofMessage, validNativeHostPolicy } from "./host.mjs";
+import {
+  CONTROLLER_BRIDGE_MODE,
+  CommandReplayGuard,
+  validateCommandResult,
+} from "./controller-protocol.mjs";
+
+const HASH = /^[0-9a-f]{64}$/u;
+const COORD = /^[A-Za-z0-9_-]{43}$/u;
+const CONTROLLER_HELLO_KEYS =
+  "client_nonce,public_key,resources,session_mode,type,version,worker_id";
+const PROOF_KEYS = "client_nonce,device_signature,server_nonce,type,version";
+const RESOURCE_KEYS =
+  "bridge_identity_sha256,browser_profile_sha256,chatgpt_target_sha256";
+const MAX_CLOCK_SKEW = 30_000;
+
+function exact(obj, fields) {
+  return (
+    obj &&
+    typeof obj === "object" &&
+    !Array.isArray(obj) &&
+    Object.keys(obj).sort().join(",") === fields
+  );
+}
+
+function isHash(v) {
+  return typeof v === "string" && HASH.test(v);
+}
+
+function validPublic(x) {
+  return (
+    exact(x, "crv,kty,x,y") &&
+    x.crv === "P-256" &&
+    x.kty === "EC" &&
+    typeof x.x === "string" &&
+    COORD.test(x.x) &&
+    typeof x.y === "string" &&
+    COORD.test(x.y)
+  );
+}
+
+function publicThumbprint(jwk) {
+  return createHash("sha256")
+    .update(JSON.stringify({ crv: "P-256", kty: "EC", x: jwk.x, y: jwk.y }))
+    .digest("hex");
+}
+
+function validResources(x) {
+  return exact(x, RESOURCE_KEYS) && Object.values(x).every(isHash);
+}
+
+function sameResources(a, b) {
+  return Object.keys(a).length === 3 && RESOURCE_KEYS.split(",").every((k) => a[k] === b[k]);
+}
+
+function matchesControllerHello(v, policy) {
+  if (
+    !exact(v, CONTROLLER_HELLO_KEYS) ||
+    v.type !== "HELLO" ||
+    v.version !== 1 ||
+    v.session_mode !== CONTROLLER_BRIDGE_MODE ||
+    v.worker_id !== policy.worker_id ||
+    !validPublic(v.public_key) ||
+    !validResources(v.resources) ||
+    !sameResources(v.resources, policy.resources) ||
+    !isHash(v.client_nonce)
+  ) {
+    return false;
+  }
+  try {
+    createPublicKey({ key: v.public_key, format: "jwk" });
+    return publicThumbprint(v.public_key) === policy.public_key_sha256;
+  } catch {
+    return false;
+  }
+}
+
+function decodeP1363(s) {
+  if (typeof s !== "string" || !/^[A-Za-z0-9_-]{86}$/u.test(s)) return null;
+  const bytes = Buffer.from(s, "base64url");
+  return bytes.length === 64 && bytes.toString("base64url") === s ? bytes : null;
+}
+
+function matchesProof(value, issued, hello, policy, origin, now) {
+  if (
+    !exact(value, PROOF_KEYS) ||
+    value.type !== "PROOF" ||
+    value.version !== 1 ||
+    value.client_nonce !== hello.client_nonce ||
+    value.server_nonce !== issued.server_nonce ||
+    now >= issued.expires_at_ms
+  ) {
+    return false;
+  }
+  const signature = decodeP1363(value.device_signature);
+  if (!signature) return false;
+  const message = nativeProofMessage({
+    origin,
+    worker_id: hello.worker_id,
+    public_key_sha256: policy.public_key_sha256,
+    profile_binding_sha256: policy.profile_binding_sha256,
+    resources: policy.resources,
+    client_nonce: hello.client_nonce,
+    server_nonce: issued.server_nonce,
+    expires_at_ms: issued.expires_at_ms,
+  });
+  try {
+    const key = createPublicKey({ key: hello.public_key, format: "jwk" });
+    return verify(
+      "sha256",
+      Buffer.from(message, "utf8"),
+      { key, dsaEncoding: "ieee-p1363" },
+      signature,
+    );
+  } catch {
+    return false;
+  }
+}
+
+async function writeBridgeFrame(stream, value) {
+  const frame = encodeFrame(value, MAX_FRAME_BYTES);
+  if (!stream.write(frame)) {
+    await new Promise((resolve, reject) => {
+      stream.once("drain", resolve);
+      stream.once("error", reject);
+    });
+  }
+}
+
+async function ensurePrivateSocketDir(socketPath) {
+  const parent = dirname(socketPath);
+  await mkdir(parent, { recursive: true, mode: 0o700 });
+  const info = await lstat(parent);
+  if (!info.isDirectory() || info.isSymbolicLink()) {
+    throw Error("CONTROLLER_IPC_DIR_UNSAFE");
+  }
+  if (typeof process.getuid === "function" && info.uid !== process.getuid()) {
+    throw Error("CONTROLLER_IPC_DIR_OWNER_INVALID");
+  }
+  await rm(socketPath, { force: true });
+}
+
+export async function runNativeControllerBridge({
+  input,
+  output,
+  policy,
+  claimedOrigin,
+  now = () => Date.now(),
+  nonce = () => randomBytes(32).toString("hex"),
+  handshakeTimeoutMs = 15_000,
+  ipcSocketPath = null,
+  onEstablished = null,
+}) {
+  const started = now();
+  if (
+    !validNativeHostPolicy(policy, started) ||
+    claimedOrigin !== policy.allowed_origin ||
+    !Number.isSafeInteger(handshakeTimeoutMs) ||
+    handshakeTimeoutMs < 100 ||
+    handshakeTimeoutMs > 15_000
+  ) {
+    throw Error("NATIVE_POLICY_DENIED");
+  }
+
+  const reader = nativeFrameReader(input, MAX_FRAME_BYTES);
+
+  const nextWithTimeout = async (timeoutMs) => {
+    let timer = null;
+    try {
+      return await Promise.race([
+        reader.next(),
+        new Promise((_, reject) => {
+          timer = setTimeout(() => reject(Error("NATIVE_TIMEOUT")), timeoutMs);
+          timer.unref?.();
+        }),
+      ]);
+    } finally {
+      if (timer !== null) clearTimeout(timer);
+    }
+  };
+
+  // Persistent controller command session state (initialized before SESSION_ESTABLISHED)
+  const guard = new CommandReplayGuard();
+  let closed = false;
+  let quarantined = false;
+  let pending = null; // { command_id, seq, timer, resolve }
+  let resolveClosed;
+  const closedPromise = new Promise((resolve) => {
+    resolveClosed = resolve;
+  });
+  let ipcServer = null;
+  const ipcSockets = new Set();
+  let sessionId = "";
+
+  const failPending = (code) => {
+    if (!pending) return;
+    const active = pending;
+    pending = null;
+    clearTimeout(active.timer);
+    quarantined = true;
+    active.resolve({
+      type: "COMMAND_RESULT",
+      version: 1,
+      command_id: active.command_id,
+      seq: active.seq,
+      ok: false,
+      code,
+      uncertain: true,
+    });
+  };
+
+  const shutdown = (reason = "BRIDGE_CLOSED") => {
+    if (closed) return;
+    closed = true;
+    failPending(reason === "BRIDGE_CLOSED" ? "BRIDGE_DISCONNECTED_UNCERTAIN" : reason);
+    reader.close();
+    for (const s of ipcSockets) {
+      try {
+        s.destroy();
+      } catch {
+        // Ignore socket destroy errors.
+      }
+    }
+    ipcSockets.clear();
+    if (ipcServer) {
+      try {
+        ipcServer.close();
+      } catch {
+        // Ignore close errors.
+      }
+      if (ipcSocketPath) {
+        void rm(ipcSocketPath, { force: true }).catch(() => undefined);
+      }
+    }
+    resolveClosed(reason);
+  };
+
+  const dispatchCommand = async (command, timeoutMs = 10_000) => {
+    if (closed) {
+      return {
+        ok: false,
+        code: "CONTROLLER_SESSION_CLOSED",
+        uncertain: false,
+      };
+    }
+    if (quarantined) {
+      return {
+        ok: false,
+        code: "CONTROLLER_SESSION_QUARANTINED",
+        uncertain: true,
+      };
+    }
+    if (pending) {
+      return {
+        ok: false,
+        code: "CONTROLLER_COMMAND_IN_FLIGHT",
+        uncertain: false,
+      };
+    }
+    const admitted = guard.admit(command, now());
+    if (!admitted.ok) {
+      return {
+        ok: false,
+        code: admitted.code,
+        uncertain: false,
+      };
+    }
+
+    if (now() >= policy.expires_at_ms) {
+      quarantined = true;
+      shutdown("NATIVE_POLICY_EXPIRED");
+      return {
+        ok: false,
+        code: "NATIVE_POLICY_EXPIRED",
+        uncertain: false,
+      };
+    }
+
+    return new Promise((resolve) => {
+      const effectiveTimeout = Number.isSafeInteger(timeoutMs) && timeoutMs >= 50 ? timeoutMs : 10_000;
+      const timer = setTimeout(() => {
+        if (pending && pending.command_id === command.command_id) {
+          pending = null;
+          quarantined = true;
+          resolve({
+            type: "COMMAND_RESULT",
+            version: 1,
+            command_id: command.command_id,
+            seq: command.seq,
+            ok: false,
+            code: "COMMAND_TIMEOUT_UNCERTAIN",
+            uncertain: true,
+          });
+        }
+      }, effectiveTimeout);
+      timer.unref?.();
+
+      pending = {
+        command_id: command.command_id,
+        seq: command.seq,
+        timer,
+        resolve,
+      };
+
+      writeBridgeFrame(output, command)
+        .then(() => {
+          if (command.action === "HALT" && pending && pending.command_id === command.command_id) {
+            const active = pending;
+            pending = null;
+            clearTimeout(active.timer);
+            quarantined = true;
+            active.resolve({
+              type: "COMMAND_RESULT",
+              version: 1,
+              command_id: command.command_id,
+              seq: command.seq,
+              ok: true,
+              code: "HALT_ISSUED",
+            });
+            const t = setTimeout(() => shutdown("CONTROLLER_HALTED"), 15);
+            t.unref?.();
+          }
+        })
+        .catch(() => {
+          failPending("BRIDGE_WRITE_FAILED_UNCERTAIN");
+          shutdown("BRIDGE_WRITE_FAILED");
+        });
+    });
+  };
+
+  // Handshake
+  try {
+    const hello = await nextWithTimeout(handshakeTimeoutMs);
+    if (!matchesControllerHello(hello, policy)) {
+      throw Error("NATIVE_HELLO_DENIED");
+    }
+    const server_nonce = nonce();
+    if (!isHash(server_nonce) || server_nonce === hello.client_nonce) {
+      throw Error("NATIVE_NONCE_DENIED");
+    }
+    const moment = now();
+    if (moment < started - MAX_CLOCK_SKEW || moment >= policy.expires_at_ms) {
+      throw Error("NATIVE_CLOCK_DENIED");
+    }
+    const expires_at_ms = Math.min(moment + handshakeTimeoutMs, policy.expires_at_ms);
+    const issued = {
+      type: "CHALLENGE",
+      version: 1,
+      server_nonce,
+      client_nonce: hello.client_nonce,
+      expires_at_ms,
+      profile_binding_sha256: policy.profile_binding_sha256,
+    };
+    await writeBridgeFrame(output, issued);
+
+    const proof = await nextWithTimeout(handshakeTimeoutMs);
+    if (!matchesProof(proof, issued, hello, policy, claimedOrigin, now())) {
+      throw Error("NATIVE_PROOF_DENIED");
+    }
+
+    if (typeof ipcSocketPath === "string" && ipcSocketPath.length > 0) {
+      await ensurePrivateSocketDir(ipcSocketPath);
+      ipcServer = createServer((socket) => {
+        ipcSockets.add(socket);
+        socket.once("close", () => ipcSockets.delete(socket));
+        let buf = "";
+        socket.on("data", (chunk) => {
+          buf += chunk.toString("utf8");
+          let idx;
+          while ((idx = buf.indexOf("\n")) >= 0) {
+            const line = buf.slice(0, idx).trim();
+            buf = buf.slice(idx + 1);
+            if (!line) continue;
+            let cmd;
+            try {
+              cmd = JSON.parse(line);
+            } catch {
+              socket.write(JSON.stringify({ ok: false, code: "IPC_JSON_INVALID" }) + "\n");
+              continue;
+            }
+            void dispatchCommand(cmd).then((res) => {
+              if (!socket.destroyed) {
+                socket.write(JSON.stringify(res) + "\n");
+              }
+            });
+          }
+        });
+      });
+      await new Promise((resolve, reject) => {
+        ipcServer.once("error", reject);
+        ipcServer.listen(ipcSocketPath, resolve);
+      });
+    }
+
+    sessionId = randomBytes(32).toString("hex");
+    await writeBridgeFrame(output, {
+      type: "SESSION_ESTABLISHED",
+      version: 1,
+      session_mode: CONTROLLER_BRIDGE_MODE,
+      session_id: sessionId,
+      worker_id: policy.worker_id,
+      public_key_sha256: policy.public_key_sha256,
+    });
+  } catch (err) {
+    shutdown("BRIDGE_HANDSHAKE_FAILED");
+    throw err;
+  }
+
+  // Pump frames coming from Chrome extension
+  const pumpExtensionFrames = (async () => {
+    try {
+      while (!closed) {
+        const frame = await reader.next();
+        if (frame.type === "KEEPALIVE_PING" && frame.version === 1 && frame.session_id === sessionId) {
+          await writeBridgeFrame(output, {
+            type: "KEEPALIVE_PONG",
+            version: 1,
+            session_id: sessionId,
+            at_ms: now(),
+          });
+          continue;
+        }
+        if (frame.type === "COMMAND_RESULT") {
+          const valid = validateCommandResult(frame);
+          if (!valid.ok || !pending || frame.command_id !== pending.command_id || frame.seq !== pending.seq) {
+            failPending("BRIDGE_PROTOCOL_MISMATCH_UNCERTAIN");
+            shutdown("BRIDGE_PROTOCOL_MISMATCH");
+            return;
+          }
+          const active = pending;
+          pending = null;
+          clearTimeout(active.timer);
+          active.resolve(frame);
+          continue;
+        }
+        // Unexpected unsolicited message breaks trust invariants
+        failPending("BRIDGE_UNEXPECTED_FRAME_UNCERTAIN");
+        shutdown("BRIDGE_UNEXPECTED_FRAME");
+        return;
+      }
+    } catch {
+      shutdown("BRIDGE_DISCONNECTED_UNCERTAIN");
+    }
+  })();
+  void pumpExtensionFrames;
+
+  const session = Object.freeze({
+    sessionId,
+    workerId: policy.worker_id,
+    publicKeySha256: policy.public_key_sha256,
+    isClosed: () => closed,
+    isQuarantined: () => quarantined,
+    dispatchCommand,
+    close: () => shutdown("BRIDGE_CLOSED"),
+    waitClosed: () => closedPromise,
+  });
+
+  if (typeof onEstablished === "function") {
+    await onEstablished(session);
+  }
+  return session;
+}
diff --git a/browser-extension/native-host/controller-protocol.mjs b/browser-extension/native-host/controller-protocol.mjs
new file mode 100644
index 0000000..2c72efb
--- /dev/null
+++ b/browser-extension/native-host/controller-protocol.mjs
@@ -0,0 +1,209 @@
+/**
+ * F1-03 authenticated native-host <-> controller bridge wire protocol.
+ * Strict exact-key allowlist, monotonic seq, command_id replay dedupe, and TTL checks.
+ */
+
+export const CONTROLLER_BRIDGE_MODE = "CONTROLLER_BRIDGE_V1";
+export const CONTROLLER_PROTOCOL_VERSION = 1;
+export const MIN_COMMAND_TTL_MS = 100;
+export const MAX_COMMAND_TTL_MS = 60_000;
+export const MAX_CLOCK_SKEW_MS = 5_000;
+export const MAX_PROMPT_CHARS = 2_048;
+
+export const ALLOWED_COMMAND_ACTIONS = Object.freeze([
+  "PING",
+  "GET_TARGET_STATUS",
+  "PREPARE_FIRST_MESSAGE",
+  "DISPATCH_FIRST_MESSAGE",
+  "PREPARE_CONTINUATION",
+  "DISPATCH_CONTINUATION",
+  "HALT",
+]);
+
+const ACTION_KEYS = {
+  PING: "action,command_id,issued_at_ms,seq,ttl_ms,type,version",
+  GET_TARGET_STATUS: "action,command_id,issued_at_ms,seq,ttl_ms,type,version",
+  PREPARE_FIRST_MESSAGE:
+    "action,attempt_id,command_id,fence_id,head_sha,issued_at_ms,pr_number,profile_id,seq,target_id,target_tab_id,ttl_ms,type,version",
+  DISPATCH_FIRST_MESSAGE:
+    "action,attempt_id,claim_id,command_id,fence_id,head_sha,issued_at_ms,pr_number,profile_id,prompt,seq,target_id,target_tab_id,ttl_ms,type,version",
+  PREPARE_CONTINUATION:
+    "action,attempt_id,command_id,expected_conversation_id,expected_turn_number,fence_id,head_sha,issued_at_ms,pr_number,profile_id,seq,target_id,target_tab_id,ttl_ms,type,version",
+  DISPATCH_CONTINUATION:
+    "action,attempt_id,claim_id,command_id,expected_conversation_id,expected_turn_number,fence_id,head_sha,issued_at_ms,pr_number,profile_id,prompt,seq,target_id,target_tab_id,ttl_ms,type,version",
+  HALT: "action,command_id,issued_at_ms,reason,seq,ttl_ms,type,version",
+};
+
+const COMMAND_ID_RE = /^[A-Za-z0-9_-]{8,128}$/;
+const ATTEMPT_ID_RE = /^[a-z0-9][a-z0-9-]{0,95}$/;
+const IDENTIFIER_RE = /^[A-Za-z0-9_-]{8,128}$/;
+const SHA40_RE = /^[a-f0-9]{40}$/;
+
+function isPlainObject(value) {
+  return value !== null && typeof value === "object" && !Array.isArray(value);
+}
+
+function hasExactKeys(obj, sortedCsv) {
+  return isPlainObject(obj) && Object.keys(obj).sort().join(",") === sortedCsv;
+}
+
+export function validateControllerCommand(frame, nowMs = Date.now()) {
+  if (!isPlainObject(frame)) {
+    return { ok: false, code: "COMMAND_NOT_OBJECT" };
+  }
+  if (frame.type !== "COMMAND" || frame.version !== CONTROLLER_PROTOCOL_VERSION) {
+    return { ok: false, code: "COMMAND_HEADER_INVALID" };
+  }
+  if (typeof frame.action !== "string" || !Object.hasOwn(ACTION_KEYS, frame.action)) {
+    return { ok: false, code: "COMMAND_ACTION_FORBIDDEN" };
+  }
+  if (!hasExactKeys(frame, ACTION_KEYS[frame.action])) {
+    return { ok: false, code: "COMMAND_SHAPE_INVALID" };
+  }
+  if (typeof frame.command_id !== "string" || !COMMAND_ID_RE.test(frame.command_id)) {
+    return { ok: false, code: "COMMAND_ID_INVALID" };
+  }
+  if (!Number.isSafeInteger(frame.seq) || frame.seq < 1) {
+    return { ok: false, code: "COMMAND_SEQ_INVALID" };
+  }
+  if (!Number.isSafeInteger(frame.issued_at_ms) || frame.issued_at_ms <= 0) {
+    return { ok: false, code: "COMMAND_TIMESTAMP_INVALID" };
+  }
+  if (
+    !Number.isSafeInteger(frame.ttl_ms) ||
+    frame.ttl_ms < MIN_COMMAND_TTL_MS ||
+    frame.ttl_ms > MAX_COMMAND_TTL_MS
+  ) {
+    return { ok: false, code: "COMMAND_TTL_INVALID" };
+  }
+  if (!Number.isSafeInteger(nowMs) || nowMs <= 0) {
+    return { ok: false, code: "COMMAND_CLOCK_INVALID" };
+  }
+  if (nowMs < frame.issued_at_ms - MAX_CLOCK_SKEW_MS) {
+    return { ok: false, code: "COMMAND_NOT_YET_VALID" };
+  }
+  if (nowMs >= frame.issued_at_ms + frame.ttl_ms) {
+    return { ok: false, code: "COMMAND_EXPIRED" };
+  }
+
+  if (frame.action === "HALT") {
+    if (
+      typeof frame.reason !== "string" ||
+      frame.reason.trim().length < 3 ||
+      frame.reason.length > 256
+    ) {
+      return { ok: false, code: "COMMAND_HALT_REASON_INVALID" };
+    }
+    return { ok: true, code: "OK" };
+  }
+
+  if (frame.action === "PING" || frame.action === "GET_TARGET_STATUS") {
+    return { ok: true, code: "OK" };
+  }
+
+  // Binding checks for prepare / dispatch commands
+  if (!Number.isSafeInteger(frame.pr_number) || frame.pr_number < 1) {
+    return { ok: false, code: "COMMAND_PR_INVALID" };
+  }
+  if (typeof frame.head_sha !== "string" || !SHA40_RE.test(frame.head_sha)) {
+    return { ok: false, code: "COMMAND_HEAD_SHA_INVALID" };
+  }
+  if (typeof frame.attempt_id !== "string" || !ATTEMPT_ID_RE.test(frame.attempt_id)) {
+    return { ok: false, code: "COMMAND_ATTEMPT_ID_INVALID" };
+  }
+  if (typeof frame.fence_id !== "string" || !IDENTIFIER_RE.test(frame.fence_id)) {
+    return { ok: false, code: "COMMAND_FENCE_ID_INVALID" };
+  }
+  if (typeof frame.target_id !== "string" || !IDENTIFIER_RE.test(frame.target_id)) {
+    return { ok: false, code: "COMMAND_TARGET_ID_INVALID" };
+  }
+  if (typeof frame.profile_id !== "string" || !IDENTIFIER_RE.test(frame.profile_id)) {
+    return { ok: false, code: "COMMAND_PROFILE_ID_INVALID" };
+  }
+  if (!Number.isSafeInteger(frame.target_tab_id) || frame.target_tab_id < 0) {
+    return { ok: false, code: "COMMAND_TAB_ID_INVALID" };
+  }
+
+  if (
+    frame.action === "PREPARE_CONTINUATION" ||
+    frame.action === "DISPATCH_CONTINUATION"
+  ) {
+    if (
+      typeof frame.expected_conversation_id !== "string" ||
+      !IDENTIFIER_RE.test(frame.expected_conversation_id)
+    ) {
+      return { ok: false, code: "COMMAND_CONVERSATION_ID_INVALID" };
+    }
+    if (!Number.isSafeInteger(frame.expected_turn_number) || frame.expected_turn_number < 2) {
+      return { ok: false, code: "COMMAND_TURN_NUMBER_INVALID" };
+    }
+  }
+
+  if (
+    frame.action === "DISPATCH_FIRST_MESSAGE" ||
+    frame.action === "DISPATCH_CONTINUATION"
+  ) {
+    if (typeof frame.claim_id !== "string" || !IDENTIFIER_RE.test(frame.claim_id)) {
+      return { ok: false, code: "COMMAND_CLAIM_ID_INVALID" };
+    }
+    if (
+      typeof frame.prompt !== "string" ||
+      frame.prompt.trim().length === 0 ||
+      frame.prompt.length > MAX_PROMPT_CHARS
+    ) {
+      return { ok: false, code: "COMMAND_PROMPT_INVALID" };
+    }
+  }
+
+  return { ok: true, code: "OK" };
+}
+
+export function validateCommandResult(frame) {
+  if (!isPlainObject(frame)) {
+    return { ok: false, code: "RESULT_NOT_OBJECT" };
+  }
+  const keys = Object.keys(frame).sort().join(",");
+  if (
+    keys !== "code,command_id,ok,seq,type,version" &&
+    keys !== "code,command_id,ok,payload,seq,type,version"
+  ) {
+    return { ok: false, code: "RESULT_SHAPE_INVALID" };
+  }
+  if (
+    frame.type !== "COMMAND_RESULT" ||
+    frame.version !== CONTROLLER_PROTOCOL_VERSION ||
+    typeof frame.command_id !== "string" ||
+    !COMMAND_ID_RE.test(frame.command_id) ||
+    !Number.isSafeInteger(frame.seq) ||
+    frame.seq < 1 ||
+    typeof frame.ok !== "boolean" ||
+    typeof frame.code !== "string" ||
+    frame.code.length === 0
+  ) {
+    return { ok: false, code: "RESULT_FIELDS_INVALID" };
+  }
+  return { ok: true, code: "OK" };
+}
+
+export class CommandReplayGuard {
+  constructor() {
+    this.lastSeq = 0;
+    this.seenCommandIds = new Set();
+  }
+
+  admit(frame, nowMs = Date.now()) {
+    const check = validateControllerCommand(frame, nowMs);
+    if (!check.ok) {
+      return check;
+    }
+    if (frame.seq <= this.lastSeq) {
+      return { ok: false, code: "COMMAND_SEQ_REPLAY" };
+    }
+    if (this.seenCommandIds.has(frame.command_id)) {
+      return { ok: false, code: "COMMAND_ID_REPLAY" };
+    }
+    this.lastSeq = frame.seq;
+    this.seenCommandIds.add(frame.command_id);
+    return { ok: true, code: "OK" };
+  }
+}
