{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "rootDir": "../..",
    "outDir": "dist",
    "types": ["node"],
    "strict": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "noEmitOnError": true,
    "skipLibCheck": true
  },
  "include": [
    "send-once-claim-adapter.ts",
    "github-f1-ledger.ts",
    "desktop-controller.ts",
    "ipc-client.ts",
    "controller-daemon.ts",
    "github-app-harness.ts",
    "github-authority-provider.ts",
    "token-lifecycle.ts",
    "command-center-observer.ts"
  ]
}
