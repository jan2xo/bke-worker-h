# BKE Worker Desktop Controller (FORGE F1) — Non-Secret Environment Template
# Copy to a private location (e.g. ~/.config/bke-worker/f1-controller.env) and chmod 600.
# NEVER commit live tokens, webhook secrets, cookies, or browser storage.

# Exact target repository and PR assignment bound to this worker instance
BKE_REPOSITORY=jan2xo/bke-worker
BKE_REPOSITORY_ID=0
BKE_INSTALLATION_ID=
BKE_PR_NUMBER=0
BKE_WORKER_ID=worker-f1

# Pinned GitHub App issuing verified bke-ticket:v1 check runs
BKE_PINNED_APP_ID=0
BKE_PINNED_APP_SLUG=bke-dispatcher-app

# Bound local browser target / profile identifiers
BKE_EXECUTION_ID=exec-desktop-01
BKE_TARGET_ID=target-desktop-01
BKE_PROFILE_ID=profile-desktop-01
BKE_TARGET_TAB_ID=0

# Private owner-only state paths (mode 0o700 dir, 0o600 files; no symlinks)
BKE_JOURNAL_PATH=$HOME/.local/state/bke-worker/f1/journal.json
BKE_CONTROLLER_IPC_SOCKET=$HOME/.local/state/bke-worker/f1/controller.sock
BKE_NATIVE_POLICY_PATH=$HOME/.config/bke-worker/native-host/owner-policy.json

# Strictly loopback listener defaults for webhook, signed envelope & owner halt endpoints
BKE_CONTROLLER_HOST=127.0.0.1
BKE_CONTROLLER_PORT=31940

# Loopback endpoint authentication secrets (min 16+ random bytes; keep strictly separated)
BKE_WEBHOOK_SECRET=REPLACE_WITH_WEBHOOK_HMAC_SECRET
BKE_OPERATOR_HALT_TOKEN=REPLACE_WITH_OPERATOR_HALT_TOKEN

# F2 Feature-gated signed execution-envelope mode (OFF by default; NEVER reuse BKE_WEBHOOK_SECRET)
BKE_EXECUTION_ENVELOPE_ENABLED=false
BKE_EXECUTION_SIGNING_KEY_ID=
BKE_EXECUTION_SIGNING_KEY=
BKE_ALLOW_REMOTE_SIGNED_HALT=false
BKE_REMOTE_HALT_SIGNING_KEY_ID=
BKE_REMOTE_HALT_SIGNING_KEY=

# Short-lived GitHub App installation token injected at runtime (never committed; remote broker disabled)
BKE_GITHUB_INSTALLATION_TOKEN=

# Safety locks: live ChatGPT sending MUST stay false by default.
# Live sending requires explicit single-session owner supervision + pre-certified proofs.
BKE_HUMAN_LIVE_SEND_AUTHORIZED=false
BKE_OWNER_SUPERVISED_LIVE_SEND=
BKE_CERT_GITHUB_CAS=false
BKE_CERT_NATIVE_PAIRING=false
BKE_CERT_REAL_BROWSER=false

# F3 Feature-gated asymmetric Ed25519 V2 protocol & trusted broker configuration (ALL OFF by default)
BKE_EXECUTION_V2_ASYMMETRIC_ENABLED=false
BKE_REQUIRE_ASYMMETRIC_V2=false
BKE_BROKER_ISSUER=
BKE_EXECUTION_AUDIENCE=
BKE_DEVICE_ID=
BKE_MIN_ENROLLMENT_GENERATION=1
BKE_BROKER_PUBLIC_KEY_ID=
BKE_BROKER_PUBLIC_KEY_PEM=
BKE_REMOTE_HALT_PUBLIC_KEY_ID=
BKE_REMOTE_HALT_PUBLIC_KEY_PEM=
BKE_REMOTE_BROKER_ENABLED=false
BKE_BROKER_BASE_URL=

# F4 Feature-gated server-mediated CAS & exact generation binding (OFF by default)
BKE_EXPECTED_ENROLLMENT_GENERATION=
BKE_SERVER_MEDIATED_CAS_ENABLED=false
